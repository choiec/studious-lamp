{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate.schema.json",
  "title": "Candidate content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "contract",
    "manifest_digest",
    "payloads",
    "semantic_content",
    "provenance",
    "processing_profile",
    "representations"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "dialect"],
      "properties": {
        "version": {
          "type": "string",
          "enum": ["0.1.0"]
        },
        "tag": {
          "type": "string",
          "enum": ["contract-v0.1.0"]
        },
        "dialect": {
          "type": "string",
          "format": "uri-reference",
          "enum": ["https://json-schema.org/draft/2020-12/schema"]
        }
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/payload"
      }
    },
    "semantic_content": {
      "$ref": "semantic-content.schema.json"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "processing_profile": {
      "$ref": "processing-profile.schema.json"
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/representation"
      }
    }
  },
  "$defs": {
    "safe_path": {
      "type": "string",
      "format": "uri-reference",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*(?:;[A-Za-z0-9!#$&^_.+-]+=[A-Za-z0-9!#$&^_.+-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safe_path"
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safe_path"
        },
        "media_type": {
          "$ref": "#/$defs/media_type"
        }
      }
    }
  }
}
