{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "processing-profile.schema.json",
  "title": "Processing profile reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ref"],
  "properties": {
    "schema": {
      "type": "string",
      "format": "uri-reference",
      "enum": ["processing-profile.schema.json"]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
